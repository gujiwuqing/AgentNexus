DATABASE_URL="mysql://user:pass@127.0.0.1:3306/agentnexus"
DATABASE_URL_TEST="mysql://user:pass@127.0.0.1:3306/agentnexus_test"

# ---------------------------------------------------------------------------
# 工作流执行队列
# 工作流可能运行数分钟（多次 LLM 调用），执行不在 HTTP 请求内完成，
# 而是入队后由 worker 消费，前端轮询获取进展。
# ---------------------------------------------------------------------------

# 是否启动进程内 worker。self-hosted（next start）保持默认 true；
# serverless 部署设为 false，并用外部 cron 定时调用 /api/workflow-jobs/tick
WORKFLOW_WORKER_ENABLED="true"

# 同时执行的工作流数量上限，用于保护 LLM 配额（默认 2）
WORKFLOW_WORKER_CONCURRENCY="2"

# 队列空闲时的轮询间隔，毫秒（默认 2000）
WORKFLOW_WORKER_POLL_MS="2000"

# 单个节点的执行超时，毫秒（默认 300000 = 5 分钟）
WORKFLOW_NODE_TIMEOUT_MS="300000"

# 外部 cron 驱动队列所需的共享密钥。
# 不设置时 /api/workflow-jobs/tick 直接返回 404（避免无鉴权的公开执行入口）
# 调用示例：curl -X POST -H "x-workflow-tick-secret: <secret>" https://host/api/workflow-jobs/tick
# WORKFLOW_TICK_SECRET=""
